{
  // Browser-half program（Web GUI 侧）：类型与声明文件。
  // 声明输出到 lib/types（tsdown 据此打包 lib/client.js）。
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  // 宿主 / 浏览器两边共用的纯逻辑（日历补齐等）也纳入本 program。
  "include": ["src/client/**/*", "src/shared/**/*"]
}

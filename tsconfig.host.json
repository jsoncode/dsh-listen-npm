{
  // Host-half program（Node 进程侧）：类型与声明文件。
  // 声明输出到 lib/types（tsdown 据此打包 lib/index.js 并发布类型）。
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  // 宿主 / 浏览器两边共用的纯逻辑（日历补齐等）也纳入本 program。
  "include": ["src/host/**/*", "src/shared/**/*"]
}
